# iag-federation-gateway — central sync + conflict resolution.
# Copy to .env for local runs. Production values live in the Railway service.

SERVICE_NAME=federation-gateway
LOG_LEVEL=info
LOG_FORMAT=text
PORT=4021

# Required. There is no memory mode: this service is the record of what every
# node has synced, so losing it on restart would re-apply or drop changes.
DATABASE_URL=postgres://svc_federation_gateway:iag_federation_gateway_dev@localhost:5432/iag_platform?sslmode=disable

# Inbound auth. Every /v1 request needs a Bearer token with this audience.
# AUDIENCE must also appear in the auth service's USER_TOKEN_AUDIENCES, or every
# user token is rejected here with "invalid or expired token" while /health
# stays green.
JWT_ISSUER=http://localhost:3001
JWKS_URL=http://localhost:3001/.well-known/jwks.json
AUDIENCE=iag.federation-gateway

# Outbound service auth — used only to register the permission catalogue.
# SERVICE_CLIENT_ID must appear in the auth service's SERVICE_CLIENT_SECRETS_JSON
# with this exact secret, or registration fails with "401 invalid client".
SERVICE_CLIENT_ID=iag-federation-gateway
SERVICE_CLIENT_SECRET=
AUTH_TOKEN_URL=http://localhost:3001/oauth/token

# Automatic conflict policy: last_write_wins | server_wins | node_wins | manual.
# An invalid value fails at boot rather than silently changing merge behaviour.
CONFLICT_STRATEGY=last_write_wins

# Batch bounds. A push is applied under row locks, so an unbounded batch would
# starve other nodes.
MAX_PUSH_BATCH=200
MAX_PULL_BATCH=500

# Must be false in production — schema changes run out of band.
AUTO_MIGRATE=true

# Events are dropped silently when disabled.
EVENT_BUS_ENABLED=false
KAFKA_BROKERS=127.0.0.1:19092

# Comma-separated; must not be '*' in production.
ALLOWED_ORIGINS=http://localhost:3000

# On Railway, prefer the private network for the URLs this service dials, while
# JWT_ISSUER stays the public issuer string that auth signs into `iss`:
#   JWKS_URL       = http://iag-authentication.railway.internal:3001/.well-known/jwks.json
#   AUTH_TOKEN_URL = http://iag-authentication.railway.internal:3001/oauth/token
