# iag-federation-gateway — central sync and conflict resolution.
SERVICE_NAME=federation-gateway
ENVIRONMENT=development
LOG_LEVEL=info
LOG_FORMAT=text
PORT=4021

# --- persistence (required) ---
DATABASE_URL=postgres://svc_federation-gateway:iag_federation-gateway_dev@localhost:5432/iag_platform?sslmode=disable
# Must be false in production — run migrations out of band.
AUTO_MIGRATE=true

# --- inbound auth (Bearer + aud, verified locally against JWKS) ---
JWT_ISSUER=http://localhost:3001
JWKS_URL=http://localhost:3001/.well-known/jwks.json
AUDIENCE=iag.federation-gateway

# --- outbound service auth (permission-catalogue registration) ---
# SERVICE_CLIENT_ID must exist in the auth service's SERVICE_CLIENT_SECRETS_JSON
# with exactly this secret, or registration fails with "401 invalid client".
SERVICE_CLIENT_ID=iag-federation-gateway
SERVICE_CLIENT_SECRET=
AUTH_TOKEN_URL=http://localhost:3001/oauth/token

# --- merge policy ---
# last_write_wins | server_wins | node_wins | manual
# An unrecognised value fails the boot rather than silently changing semantics.
CONFLICT_STRATEGY=last_write_wins

# Batch ceilings. A push is applied under row locks, so an unbounded batch would
# starve other nodes.
MAX_PUSH_BATCH=200
MAX_PULL_BATCH=500

# --- CORS (set explicitly in production; * is rejected there) ---
# ALLOWED_ORIGINS=https://example.com

# --- events (optional) ---
EVENT_BUS_ENABLED=false
# KAFKA_BROKERS=localhost:19092

# On Railway, prefer the private network so a public-edge outage cannot break
# boot. JWT_ISSUER stays the public issuer string — it is a token claim.
# JWKS_URL=http://iag-authentication.railway.internal:3001/.well-known/jwks.json
# AUTH_TOKEN_URL=http://iag-authentication.railway.internal:3001/oauth/token
