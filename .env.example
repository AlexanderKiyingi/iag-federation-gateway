# See config/.env.example for the full annotated environment reference.
SERVICE_NAME=federation-gateway
PORT=4021
# Required — there is no memory mode; this service is the record of what every
# node has synced.
DATABASE_URL=postgres://svc_federation_gateway:iag_federation_gateway_dev@localhost:5432/iag_platform?sslmode=disable
AUDIENCE=iag.federation-gateway
JWKS_URL=http://localhost:3001/.well-known/jwks.json
CONFLICT_STRATEGY=last_write_wins
